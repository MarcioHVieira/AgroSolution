{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Identidade": {
    "Url": "http://localhost:5001"
  },
  "Jwt": {
    "Issuer": "AgroSolutions.Identidade",
    "Audience": "AgroSolutions",
    "RequireHttpsMetadata": false,
    "ClockSkewSeconds": 0,
    "EnableDetailedLogs": false
  },
  "RabbitMQ": {
    "HostName": "",
    "Port": "5672",
    "UserName": "",
    "Password": "",
    "QueueName": "alertas-notificacoes"
  },
  "EmailSettings": {
    "SmtpServer": "",
    "SmtpPort": 587,
    "SmtpUser": "",
    "SmtpPassword": "",
    "FromEmail": "",
    "FromName": "AgroSolutions",
    "EnableSsl": true,
    "TimeoutSeconds": 30
  }
}
