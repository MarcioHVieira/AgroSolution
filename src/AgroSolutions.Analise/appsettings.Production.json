{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Error"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Identidade": {
    "Url": "http://localhost:5001"
  },
  "Jwt": {
    "Issuer": "AgroSolutions.Identidade",
    "Audience": "AgroSolutions",
    "RequireHttpsMetadata": true,
    "ClockSkewSeconds": 0,
    "EnableDetailedLogs": false
  },
  "RabbitMQ": {
    "HostName": "",
    "Port": "5672",
    "UserName": "",
    "Password": "",
    "ExchangeName": "agrosolutions-exchange",
    "ExchangeType": "topic",
    "QueueName": "leituras-processadas",
    "RoutingKey": "leitura.processada",
    "ExchangeAlertas": "agrosolutions.alertas",
    "Durable": true,
    "AutoDelete": false,
    "Exclusive": false,
    "AutomaticRecoveryEnabled": true,
    "NetworkRecoveryIntervalSeconds": 10,
    "QoS": {
      "PrefetchSize": 0,
      "PrefetchCount": 1,
      "Global": false
    }
  },
  "MotorRegras": {
    "StartupDelaySeconds": 10,
    "IntervaloAvaliacaoMinutos": 5,
    "MaxLeiturasQuery": {
      "Horas24": 100,
      "Horas6": 50,
      "Horas48": 200
    },
    "RegrasSeca": {
      "Habilitada": true,
      "ThresholdUmidade": 30,
      "DuracaoHoras": 24,
      "SeveridadeCritico": 15,
      "SeveridadeAlto": 20
    },
    "RegrasGeada": {
      "Habilitada": true,
      "ThresholdTemperatura": 5,
      "DuracaoHoras": 6,
      "SeveridadeCritico": 0,
      "SeveridadeAlto": 2
    },
    "RegrasCalorExcessivo": {
      "Habilitada": true,
      "ThresholdTemperatura": 35,
      "DuracaoHoras": 6,
      "SeveridadeCritico": 42,
      "SeveridadeAlto": 38
    },
    "RegrasExcessoUmidade": {
      "Habilitada": true,
      "ThresholdUmidade": 85,
      "DuracaoHoras": 48,
      "SeveridadeAlto": 95
    },
    "RegrasRiscoPraga": {
      "Habilitada": true,
      "TemperaturaMinima": 20,
      "TemperaturaMaxima": 30,
      "ThresholdUmidade": 70,
      "PercentualCondicoes": 70,
      "DuracaoHoras": 48
    }
  }
}
